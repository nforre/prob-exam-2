  </footer>

  <script>
    // Solution toggler
    function toggleSol(id) {
      const el = document.getElementById(id);
      el.classList.toggle('hidden');
      if (window.renderMathInElement) {
        renderMathInElement(el, {delimiters: [{left: '$$', right: '$$', display: true}, {left: '$', right: '$', display: false}]});
      }
    }

    // Quiz answer revealer
    function revealQuiz(id) {
      document.getElementById(id).classList.remove('hidden');
    }

    // Normal calculation widget
    function calcNormal() {
      const mu = parseFloat(document.getElementById('norm-mu').value) || 0;
      const vr = parseFloat(document.getElementById('norm-var').value) || 0;
      const a = parseFloat(document.getElementById('norm-a').value) || 0;
      const b = parseFloat(document.getElementById('norm-b').value) || 0;

      const newMu = a * mu + b;
      const newVar = (a * a) * vr;
      const newSd = Math.sqrt(newVar);

      document.getElementById('norm-result').innerText = 
        `E[Y] = ${newMu.toFixed(3)}, Var(Y) = ${newVar.toFixed(3)}, SD(Y) = ${newSd.toFixed(3)}`;
    }

    // Mixture CDF widget
    function calcMixCDF() {
      const x = parseFloat(document.getElementById('mix-x').value);
      let fx = 0;
      if (x < 0) {
        fx = 0;
      } else {
        fx = 1 - 0.5 * Math.exp(-4 * x) - 0.5 * Math.exp(-2 * x);
      }
      document.getElementById('mix-result').innerText = `FX(${x}) = ${fx.toFixed(5)}`;
    }
  </script>
